{
  "name": "urbont-payments",
  "version": "2.0.2",
  "private": true,
  "description": "URBONT PAYMENTS — capa de abstracción de pagos de URBONT Mobility Technology Inc.",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build && node -e \"require('fs').cpSync('db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/src/main.js",
    "migrate": "tsx db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "dotenv": "^17.4.1",
    "nestjs-pino": "^4.4.0",
    "pg": "^8.16.3",
    "pino": "^9.9.5",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "square": "^46.0.0",
    "stripe": "^20.4.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.9",
    "@types/pg": "^8.15.5",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.4"
  }
}
