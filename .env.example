# URBONT PAYMENTS — variables del servicio
#
# En producción NINGUNA de estas se escribe en un fichero ni en la imagen: ECS
# las inyecta desde AWS Secrets Manager. Este fichero es sólo para desarrollo.

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
# Los registros salen como texto legible. `json` devuelve el JSON de pino tal cual.
# LOG_FORMAT=json
# Las sondas del balanceador (/healthz, /readyz) no se registran mientras van bien.
# LOG_HEALTHCHECKS=true
# Líneas de stack que se enseñan en un error inesperado (4).
# LOG_STACK_FRAMES=4

# Postgres. El usuario sólo debe tener permisos sobre el esquema `payments`.
DATABASE_URL=postgres://urbont_payments:cambiame@localhost:5432/urbont

# El procesador que atiende los cobros nuevos: stripe | square | adyen | finix | paypal | ach
PAYMENT_PROVIDER=stripe

# Secreto compartido con urbont-api para firmar las llamadas entre servicios.
# Mínimo 16 caracteres. Genera uno con: openssl rand -hex 32
SERVICE_SHARED_SECRET=

# A dónde avisa este servicio cuando un cobro cambia de estado.
URBONT_API_URL=https://api.urbont.com

# Dirección pública de ESTE servicio, sin barra al final. El panel arma con ella
# el enlace de webhooks de cada pasarela. Vacío = https://payments.urbont.com
# PAYMENTS_PUBLIC_URL=https://payments.urbont.com

# ── Credenciales de cada procesador ─────────────────────────────────────────
#
# Desde la fase 7 esto es el RESPALDO, no el sitio normal: las credenciales se
# pegan en el panel (URBONT PAYMENTS → Configuración), se prueban contra el
# procesador antes de guardarse y se guardan cifradas con CREDENTIALS_KEY. Lo
# que esté aquí MANDA sobre lo del panel, porque es lo que está desplegado.
#
# La clave maestra con la que se cifran. Sin ella el panel no puede guardar
# ninguna credencial:  openssl rand -hex 32
# CREDENTIALS_KEY=

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_WEBHOOK_SECRET_CONNECT=
# STRIPE_TERMINAL_LOCATION_ID=

# Square. Hacen falta LAS DOS: sin localización rechaza cada cobro.
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# sandbox | production  (vacío = production)
# SQUARE_ENVIRONMENT=sandbox
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# La URL EXACTA del panel de Square: Square firma incluyéndola, y un carácter
# de diferencia hace que ninguna firma cuadre nunca.
# SQUARE_WEBHOOK_NOTIFICATION_URL=https://payments.urbont.com/webhooks/square
